  "cards": [
    { "dot": "cyan", "title": "責務の線引き", "items": [
      "Network は重複名・重複接続・start/end の一意性を検証しない(検証は Stage 2 のパーサの責務)",
      "start_zone / end_zone は役割が1つでない場合だけ SimulationError を出す"
    ] },
    { "dot": "emerald", "title": "参照の仕方", "items": [
      "Connection と Drone はゾーンをオブジェクトではなく名前(str)で持つ",
      "start/end の max_drones は常に None(パーサが正規化)、容量は無制限扱い"
    ] },
    { "dot": "amber", "title": "Drone の状態", "items": [
      "シミュレーションでは全機を AT_ZONE で start に置き、WAITING は使わない",
      "IN_TRANSIT の間だけ in_transit_connection / transit_target / turns_remaining が入る"
    ] }
