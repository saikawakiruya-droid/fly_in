  "cards": [
    { "dot": "cyan", "title": "実行の流れ", "items": [
      "main → Application.run: ① マップを World に変換 ② Pathfinder・Scheduler・Engine を組み立てて run ③ 返ってきた turns から RunSummary を標準エラーへ",
      "Pathfinder は構築時に start→end の到達性を確認し、届かなければ UnreachableGoalError",
      "World(Network)は Pathfinder・Scheduler・Engine・各ビューが読み取り専用で共有する"
    ] },
    { "dot": "emerald", "title": "毎ターン(Stage 4/5)", "items": [
      "Scheduler が MoveOrder を決め、TurnResolver が規則を検査してから SimulationState に適用し Move を返す",
      "ターンの全 Move を CompositeVisualizer 経由で TurnLogPrinter と選択されたビューへ渡す"
    ] },
    { "dot": "amber", "title": "出力の分離", "items": [
      "標準出力にはターンログだけを書く(課題の出力形式)",
      "端末表示・summary・警告・error は標準エラー",
      "ビューの close 失敗は _GuardedView が保持し、warning 1行に留める"
    ] },
    { "dot": "rose", "title": "エラーと終了コード", "items": [
      "FlyInError(MapFileError / ParseError / UnreachableGoalError / SimulationError / VisualizationError) → error: 行、終了 1",
      "Ctrl+C → 130、引数不正 → argparse が 2、想定外の例外 → internal error 1行(FLYIN_DEBUG=1 なら送出)"
    ] }
  ]
