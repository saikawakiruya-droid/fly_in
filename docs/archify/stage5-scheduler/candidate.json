  "cards": [
    { "dot": "cyan", "title": "decide_moves の順序", "items": [
      "1. 飛行中のドローンには命令しない(着陸は表に landing として載る)",
      "2. 表にある今ターン出発の予定(退去)を先に命令する",
      "3. 残りを「ゴールまでの距離が近い順 → 優先ルート上 → drone_id」で決める(下流から空ける)"
    ] },
    { "dot": "emerald", "title": "1機の決め方(_decide / _try_hop)", "items": [
      "next_hops を順に試し、接続に空きがあり、入るターン以降ずっと席がある最初の手を取る",
      "どれも無理なら同じ順で退去ありで再試行。restricted は着陸ターンから席を空けさせる",
      "それでも無理なら待機(命令なし)。遠回りはしない。失敗した試行は mark / rollback で取り消す"
    ] },
    { "dot": "amber", "title": "TurnLedger の数え方", "items": [
      "投影人数 = state.occupancy + 予定の入り − 予定の出 + このターン記録済みの命令",
      "接続は出発するターンだけ容量を使う(着陸側は使わない)。start / end は常に席あり"
    ] },
    { "dot": "rose", "title": "Evictor", "items": [
      "占有者のうち最小 drone_id を選び、そのゾーンの next_hops 先へ指定ターンに出る予約を書く",
      "行き先に席がなければ、そこの占有者を同様に退去(再帰)。距離が必ず減るので必ず終わる"
    ] }
